# 改动规则:只加不减,拿不准先开 issue。
# 系统杂物
.DS_Store

# 依赖与构建产物
node_modules/
motion-playground/dist/

# 导出产物(透明 MOV/WebM/PNG 序列,动辄数 GB)
motion-playground/exports/

# 视频素材:源片、demo 录屏都不进仓库(体积大,GitHub 单文件限 100MB)
*.mp4
*.mov
*.webm
*.m4v

# 本地日志
*.log

# 每期进度状态(个人工作文件,不进仓库)
**/STATUS.md


# 自己生成的编排文件只留本地
/overlay*.json

# 临时截图脚本
motion-playground/_*.mjs

# 本地自定义字体不进仓库，保留目录说明。
motion-playground/src/assets/fonts/*
!motion-playground/src/assets/fonts/README.md

# 演示素材:仓库只带内置示例必需的编排和字幕。
# 历次工作留下的截图/照片(含他人肖像、群聊截图)本地保留但不进仓库、不随开源分发
motion-playground/public/demo/*
!motion-playground/public/demo/demo-overlay.json
!motion-playground/public/demo/demo.srt
!motion-playground/public/demo/README.txt

# 本地 PNG 品牌素材不进仓库；内置 SVG 保留。
motion-playground/public/logos/*.png

# 用户自定义音效不进仓库，保留目录说明。
motion-playground/public/sfx/*
!motion-playground/public/sfx/README.md

# Agent Skill 的个人偏好(只留本机)
.agents/skills/overlay-fx-generator/经验规则.md
.agents/skills/overlay-fx-generator/我的偏好.md

# 示例
/demos/
